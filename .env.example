# Required on Vercel: Neon Postgres connection string (pooled URL recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Required on Vercel: generate with `openssl rand -base64 48`
AUTH_SECRET=replace-with-a-long-random-secret
# Used only when the production database is initialized for the first time
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
